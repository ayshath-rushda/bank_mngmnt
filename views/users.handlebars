<section class="cards">
    <article class="card">
        <h2>Users</h2>
        {{#if message}}
            <p class="message">{{message}}</p>
        {{/if}}
        <form action="/web/users" method="post">
            <label>
                Name
                <input type="text" name="name" required />
            </label>
            <label>
                Phone
                <input type="text" name="phone" required />
            </label>
            <label>
                Date of Birth
                <input type="date" name="dob" required />
            </label>
            <button type="submit">Create User</button>
        </form>
    </article>

    <article class="card">
        <h2>All Users</h2>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>DOB</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {{#each users}}
                    <tr>
                        <td>{{this.name}}</td>
                        <td>{{this.phone}}</td>
                        <td>{{formatDate this.dob}}</td>
                        <td>
                            <form action="/web/users/delete/{{this._id}}" method="post" style="display:inline;">
                                <button type="submit" style="background:#c73e1d; padding: 0.4rem 0.6rem; font-size: 0.8rem;">Delete</button>
                            </form>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    </article>
</section>
